
/* General styling */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f4f6f9;
    color: #333;
}

/* Dashboard layout */
.dashboard {
    display: flex;
    min-height: 100vh;
}

/* Sidebar */
.sidebar {
    width: 250px;
    background: #172554;
    color: white;
    padding: 25px 15px;
}

.sidebar h2 {
    text-align: center;
    margin-bottom: 35px;
}

.sidebar ul {
    list-style: none;
}

.sidebar ul li {
    margin: 15px 0;
}

.sidebar ul li a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 13px;
    border-radius: 6px;
    transition: 0.3s;
}

.sidebar ul li a:hover,
.sidebar ul li a.active {
    background: #2563eb;
}

/* Main content */
.main-content {
    flex: 1;
    padding: 25px;
    overflow-x: auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.header h1 {
    color: #172554;
}

/* Dashboard cards */
.cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.card h3 {
    color: #64748b;
    margin-bottom: 15px;
}

.card p {
    font-size: 28px;
    font-weight: bold;
    color: #172554;
}

/* Parking slots */
.parking-section {
    background: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
}

.parking-section h2 {
    margin-bottom: 20px;
    color: #172554;
}

.parking-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
}

.slot {
    padding: 25px 10px;
    text-align: center;
    border-radius: 8px;
    color: white;
    font-weight: bold;
    font-size: 18px;
}

.available {
    background: #16a34a;
}

.occupied {
    background: #dc2626;
}

/* Tables */
.table-container {
    background: white;
    padding: 20px;
    border-radius: 10px;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    padding: 13px;
    text-align: left;
    border-bottom: 1px solid #ddd;
}

th {
    background: #172554;
    color: white;
}

tr:hover {
    background: #f1f5f9;
}

/* Buttons */
button,
.btn {
    background: #2563eb;
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
}

button:hover,
.btn:hover {
    background: #1d4ed8;
}

/* Forms */
form {
    background: white;
    padding: 20px;
    border-radius: 10px;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    margin: 10px 0 18px;
    border: 1px solid #ccc;
    border-radius: 5px;
}

/* Status */
.status-available {
    color: #16a34a;
    font-weight: bold;
}

.status-occupied {
    color: #dc2626;
    font-weight: bold;
}

/* Responsive design */
@media (max-width: 900px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .parking-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 600px) {
    .dashboard {
        flex-direction: column;
    }

    .sidebar {
        width: 100%;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .parking-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }
}
