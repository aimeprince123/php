
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f3f6fb;
    color: #172033;
}

/* LOGIN AND REGISTRATION */

.auth-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    background: linear-gradient(135deg, #092b66, #1676a8);
}

.auth-card {
    width: 100%;
    max-width: 420px;
    padding: 32px;
    background: white;
    border-radius: 14px;
    box-shadow: 0 12px 35px rgba(0,0,0,.18);
}

.auth-card h1 {
    color: #092b66;
}

label {
    display: block;
    margin: 17px 0 7px;
    font-weight: bold;
}

input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ccd4e0;
    border-radius: 7px;
}

button {
    width: 100%;
    margin-top: 22px;
    padding: 13px;
    border: none;
    border-radius: 7px;
    background: #0b5cad;
    color: white;
    cursor: pointer;
}

button:hover {
    background: #084987;
}

.error {
    color: red;
}

/* DASHBOARD HEADER */

.topbar {
    background: #092b66;
    color: white;
    padding: 20px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logout {
    background: red;
    color: white;
    padding: 10px 16px;
    text-decoration: none;
    border-radius: 7px;
}

/* DASHBOARD */

.container {
    width: 92%;
    max-width: 1150px;
    margin: 28px auto;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 22px;
}

.stat, .panel {
    background: white;
    padding: 20px;
    border-radius: 11px;
    box-shadow: 0 3px 14px rgba(20,40,80,.06);
}

.stat span {
    display: block;
    color: #667085;
}

.stat strong {
    display: block;
    margin-top: 10px;
    font-size: 30px;
    color: #092b66;
}

/* PARKING SLOTS */

.slot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(115px, 1fr));
    gap: 12px;
}

.slot {
    min-height: 90px;
    padding: 13px;
    border-radius: 9px;
    color: white;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
}

.available {
    background: #198754;
}

.occupied {
    background: #dc3545;
}

.maintenance {
    background: #e5a000;
}

.hint {
    color: #667085;
    font-size: 13px;
}

/* TABLES */

.table-wrap {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 650px;
}

th, td {
    padding: 12px;
    border-bottom: 1px solid #e8edf4;
    text-align: left;
}

th {
    background: #f1f5fa;
}

/* FOOTER */

.footer {
    text-align: center;
    padding: 24px;
    color: #667085;
}

/* RESPONSIVE */

@media(max-width: 750px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media(max-width: 420px) {

    .stats {
        grid-template-columns: 1fr;
    }

}
